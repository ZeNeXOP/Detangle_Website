# Noopur's WhatsApp number, in international format with no "+", spaces or
# leading zeros (e.g. 919876543210 for an Indian +91 98765 43210 number).
# Used to build the wa.me link/QR code shown when someone registers interest
# in an upcoming event. Not sensitive (it's the number that already shows in
# the wa.me link itself), but still lives in .env rather than committed code
# so it's easy to change without a release.
VITE_NOOPUR_WHATSAPP_NUMBER=
