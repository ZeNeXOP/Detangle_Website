PORT=5000
FLASK_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=detangle_db
MONGODB_COLLECTION_NAME=bookings
SECRET_KEY=change-me-to-a-long-random-string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Booking notifications (both optional — a booking still saves fine with
# either or both left blank; that channel is just skipped with a log line).
# Email via Resend (https://resend.com):
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
# WhatsApp via Twilio's WhatsApp Business API (needs an approved sender +
# message template outside the sandbox — see Docs/Setup.md):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
NOTIFY_WHATSAPP_TO=
